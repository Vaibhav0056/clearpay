# Paste into Streamlit Community Cloud > your app > Settings > Secrets (NOT into the repo).
# Root-level keys are exposed to the app as environment variables.

# Supabase > Connect > Session pooler (IPv4). Must start with postgresql:// and include the
# URL-encoded database password. Leave out to use a temporary SQLite file that resets on restart.
SUPABASE_DB_URL = "postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Gemini through its OpenAI-compatible endpoint (Google AI Studio API key).
OPENAI_COMPATIBLE_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
OPENAI_COMPATIBLE_API_KEY = "<gemini-api-key>"
OPENAI_COMPATIBLE_MODEL = "gemini-3.1-flash-lite"

AGENT_ENABLED = "1"
EMBEDDINGS_ENABLED = "0"
OCR_ENABLED = "0"
