# Copy to .env. Fill the two secrets below and keep .env private.
# Supabase Dashboard > Connect > Session pooler: copy the PostgreSQL URI.
# URL-encode special characters in its database password.
SUPABASE_DB_URL=

# Gemini API key from Google AI Studio. No OpenAI key is needed.
OPENAI_COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gemini-3.1-flash-lite
OPENAI_COMPATIBLE_FALLBACK_MODELS=gemini-2.5-flash

# MVP: deterministic finance rules, LangGraph routing and lexical retrieval.
AGENT_ENABLED=1
EMBEDDINGS_ENABLED=0
RERANKER_MODEL=

# Gemini receives page images, including scans. Local OCR is optional.
OCR_ENABLED=0

# Optional: enable only a tax-rate policy applicable to your invoices.
# ALLOWED_TAX_RATES=0,5,12,18,28

# Offline demo fallback when SUPABASE_DB_URL is empty.
# INVOICEIQ_DB=./invoiceiq.sqlite
